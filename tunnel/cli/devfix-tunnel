#!/bin/bash
# DevFix Tunnel — macOS Snowflake + safe System Proxy controller
# Stable DevFix remains separate; this product owns independent state/runtime.

set -u

TUNNEL_VERSION="0.2.0-rc1"
TUNNEL_NAME="DevFix Tunnel"
TUNNEL_TEST_MODE="${DEVFIX_TUNNEL_TEST_MODE:-0}"

SELF_PATH="${BASH_SOURCE[0]}"
SELF_DIR=$(cd -- "$(dirname -- "$SELF_PATH")" 2>/dev/null && pwd)
if [ -z "$SELF_DIR" ]; then
  SELF_DIR=$(pwd)
fi

if [ "$(uname -s 2>/dev/null || printf unknown)" = "Darwin" ]; then
  TUNNEL_STATE_ROOT="${DEVFIX_TUNNEL_STATE_DIR:-$HOME/Library/Application Support/DevFixTunnel}"
  TUNNEL_LOG_DIR="${DEVFIX_TUNNEL_LOG_DIR:-$HOME/Library/Logs/DevFixTunnel}"
else
  TUNNEL_STATE_ROOT="${DEVFIX_TUNNEL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/devfix-tunnel}"
  TUNNEL_LOG_DIR="${DEVFIX_TUNNEL_LOG_DIR:-$TUNNEL_STATE_ROOT/logs}"
fi

TUNNEL_LIBEXEC_DIR="${DEVFIX_TUNNEL_LIBEXEC_DIR:-/usr/local/libexec/devfix-tunnel}"
TUNNEL_TOR_BIN="${DEVFIX_TUNNEL_TOR_BIN:-$TUNNEL_LIBEXEC_DIR/tor/tor}"
TUNNEL_LYREBIRD_BIN="${DEVFIX_TUNNEL_LYREBIRD_BIN:-$TUNNEL_LIBEXEC_DIR/tor/pluggable_transports/lyrebird}"
TUNNEL_GUARDIAN_BIN="${DEVFIX_TUNNEL_GUARDIAN_BIN:-$TUNNEL_LIBEXEC_DIR/devfix-tunnel-guardian}"
if [ ! -x "$TUNNEL_GUARDIAN_BIN" ] && [ -x "$SELF_DIR/../libexec/devfix-tunnel-guardian" ]; then
  TUNNEL_GUARDIAN_BIN="$SELF_DIR/../libexec/devfix-tunnel-guardian"
fi

TUNNEL_RUN_DIR="$TUNNEL_STATE_ROOT/run"
TUNNEL_TOR_DATA_DIR="$TUNNEL_STATE_ROOT/tor-data"
TUNNEL_STATE_FILE="$TUNNEL_RUN_DIR/state"
TUNNEL_PID_FILE="$TUNNEL_RUN_DIR/tor.pid"
TUNNEL_TORRC="$TUNNEL_RUN_DIR/torrc"
TUNNEL_STOP_REQUEST="$TUNNEL_RUN_DIR/system-proxy.stop"
TUNNEL_PROXY_READY="$TUNNEL_RUN_DIR/system-proxy.ready"
TUNNEL_PROXY_FAILED="$TUNNEL_RUN_DIR/system-proxy.failed"
TUNNEL_PROXY_RESTORED="$TUNNEL_RUN_DIR/system-proxy.restored"
TUNNEL_GUARDIAN_LOG="$TUNNEL_LOG_DIR/guardian-launch.log"
TUNNEL_LOG="$TUNNEL_LOG_DIR/devfix-tunnel.log"
TUNNEL_TOR_LOG="$TUNNEL_LOG_DIR/tor.log"

DEFAULT_SOCKS_PORT="${DEVFIX_TUNNEL_SOCKS_PORT:-19150}"
BOOTSTRAP_TIMEOUT="${DEVFIX_TUNNEL_BOOTSTRAP_TIMEOUT:-600}"
STALL_TIMEOUT="${DEVFIX_TUNNEL_STALL_TIMEOUT:-180}"
VALIDATION_TIMEOUT="${DEVFIX_TUNNEL_VALIDATION_TIMEOUT:-30}"
GUARDIAN_START_TIMEOUT="${DEVFIX_TUNNEL_GUARDIAN_START_TIMEOUT:-30}"
GUARDIAN_STOP_TIMEOUT="${DEVFIX_TUNNEL_GUARDIAN_STOP_TIMEOUT:-20}"

DEFAULT_SNOWFLAKE_BRIDGE='snowflake 192.0.2.3:80 2B280B23E1107BB62ABFC40DDCC8824814F80A72 fingerprint=2B280B23E1107BB62ABFC40DDCC8824814F80A72 url=https://1098762253.rsc.cdn77.org front=www.phpmyadmin.net,cdn.zk.mk ice=stun:stun.antisip.com:3478,stun:stun.epygi.com:3478,stun:stun.uls.co.za:3478,stun:stun.voipgate.com:3478,stun:stun.mixvoip.com:3478,stun:stun.nextcloud.com:3478,stun:stun.bethesda.net:3478,stun:stun.nextcloud.com:443 utls-imitate=hellorandomizedalpn'
SNOWFLAKE_BRIDGE="${DEVFIX_TUNNEL_SNOWFLAKE_BRIDGE:-$DEFAULT_SNOWFLAKE_BRIDGE}"

info() { printf '%s\n' "$*"; }
warn() { printf 'Warning: %s\n' "$*" >&2; }
err() { printf 'Error: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
now_utc() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
now_epoch() { date '+%s'; }

ensure_dirs() {
  umask 077
  mkdir -p "$TUNNEL_STATE_ROOT" "$TUNNEL_RUN_DIR" "$TUNNEL_TOR_DATA_DIR" "$TUNNEL_LOG_DIR" ||
    die "cannot create DevFix Tunnel state directories"
  chmod 700 "$TUNNEL_STATE_ROOT" "$TUNNEL_RUN_DIR" "$TUNNEL_TOR_DATA_DIR" "$TUNNEL_LOG_DIR" 2>/dev/null || true
}

log_line() {
  ensure_dirs
  printf '%s %s\n' "$(now_utc)" "$*" >> "$TUNNEL_LOG" 2>/dev/null || true
}

state_get() {
  key="$1"
  default_value="${2:-}"
  [ -f "$TUNNEL_STATE_FILE" ] || { printf '%s' "$default_value"; return; }
  value=$(sed -n "s/^${key}=//p" "$TUNNEL_STATE_FILE" | tail -n 1)
  if [ -n "$value" ]; then printf '%s' "$value"; else printf '%s' "$default_value"; fi
}

write_state() {
  state="$1"; mode="$2"; pid="$3"; port="$4"; session="$5"; started="$6"; service="${7:-}"
  ensure_dirs
  tmp="$TUNNEL_STATE_FILE.tmp.$$"
  umask 077
  {
    printf 'SCHEMA=2\n'
    printf 'STATE=%s\n' "$state"
    printf 'MODE=%s\n' "$mode"
    printf 'PID=%s\n' "$pid"
    printf 'SOCKS_PORT=%s\n' "$port"
    printf 'SESSION=%s\n' "$session"
    printf 'STARTED=%s\n' "$started"
    printf 'PROXY_SERVICE=%s\n' "$service"
    printf 'TORRC=%s\n' "$TUNNEL_TORRC"
  } > "$tmp" || die "cannot write temporary tunnel state"
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$TUNNEL_STATE_FILE" || die "cannot atomically replace tunnel state"
}

clear_runtime_state() {
  rm -f "$TUNNEL_STATE_FILE" "$TUNNEL_PID_FILE" "$TUNNEL_TORRC"
  rm -f "$TUNNEL_STOP_REQUEST" "$TUNNEL_PROXY_READY" "$TUNNEL_PROXY_FAILED" "$TUNNEL_PROXY_RESTORED"
}

is_pid_alive() { pid="$1"; case "$pid" in ''|*[!0-9]*) return 1 ;; esac; kill -0 "$pid" 2>/dev/null; }
process_command() { ps -p "$1" -o command= 2>/dev/null || true; }

pid_is_owned() {
  pid="$1"
  is_pid_alive "$pid" || return 1
  [ "$TUNNEL_TEST_MODE" = "1" ] && return 0
  cmd=$(process_command "$pid")
  [ -n "$cmd" ] || return 1
  case "$cmd" in *"$TUNNEL_TOR_BIN"*"$TUNNEL_TORRC"*) return 0 ;; *) return 1 ;; esac
}

port_in_use() {
  port="$1"
  if command -v nc >/dev/null 2>&1; then nc -z -w 1 127.0.0.1 "$port" >/dev/null 2>&1; return $?; fi
  return 1
}

choose_socks_port() {
  p="$1"; i=0
  while [ "$i" -lt 20 ]; do
    if ! port_in_use "$p"; then printf '%s' "$p"; return 0; fi
    p=$((p + 1)); i=$((i + 1))
  done
  return 1
}

torrc_quote() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

write_torrc() {
  port="$1"; ensure_dirs; q_data=$(torrc_quote "$TUNNEL_TOR_DATA_DIR")
  case "$TUNNEL_LYREBIRD_BIN" in *' '*|*$'\t'*|*$'\n'*|*$'\r'*) die "lyrebird executable path contains whitespace" ;; esac
  cat > "$TUNNEL_TORRC" <<EOF
DataDirectory $q_data
SocksPort 127.0.0.1:$port
ClientOnly 1
AvoidDiskWrites 1
UseBridges 1
ClientTransportPlugin snowflake exec $TUNNEL_LYREBIRD_BIN
Bridge $SNOWFLAKE_BRIDGE
Log notice stdout
EOF
  chmod 600 "$TUNNEL_TORRC" 2>/dev/null || true
}

curl_bin() {
  if [ -n "${DEVFIX_TUNNEL_CURL_BIN:-}" ] && [ -x "$DEVFIX_TUNNEL_CURL_BIN" ]; then printf '%s' "$DEVFIX_TUNNEL_CURL_BIN";
  elif [ -x /usr/bin/curl ]; then printf '%s' /usr/bin/curl;
  elif command -v curl >/dev/null 2>&1; then command -v curl; else return 1; fi
}

validate_socks_route() {
  port="$1"; [ "$TUNNEL_TEST_MODE" = "1" ] && return 0
  cb=$(curl_bin) || return 1
  for url in 'https://www.torproject.org/' 'https://example.com/'; do
    code=$("$cb" -L -sS -o /dev/null -w '%{http_code}' --proxy "socks5h://127.0.0.1:$port" --connect-timeout 10 --max-time "$VALIDATION_TIMEOUT" "$url" 2>/dev/null || printf '000')
    case "$code" in 2??|3??|401|403) return 0 ;; esac
  done
  return 1
}

bootstrap_percent() {
  [ -f "$TUNNEL_TOR_LOG" ] || { printf '0'; return; }
  value=$(sed -nE 's/.*Bootstrapped ([0-9]+)%.*/\1/p' "$TUNNEL_TOR_LOG" | tail -n 1)
  case "$value" in ''|*[!0-9]*) printf '0' ;; *) printf '%s' "$value" ;; esac
}

stop_owned_tor() {
  pid="$1"; if ! is_pid_alive "$pid"; then return 0; fi
  if ! pid_is_owned "$pid"; then warn "refusing to terminate PID $pid because DevFix Tunnel ownership could not be proven"; return 2; fi
  kill "$pid" 2>/dev/null || true
  deadline=$(( $(now_epoch) + 5 ))
  while is_pid_alive "$pid" && [ "$(now_epoch)" -lt "$deadline" ]; do sleep 0.25; done
  if is_pid_alive "$pid"; then kill -KILL "$pid" 2>/dev/null || true; fi
}

runtime_available() { [ -x "$TUNNEL_TOR_BIN" ] && [ -x "$TUNNEL_LYREBIRD_BIN" ]; }

start_transport() {
  requested_mode="$1"
  ensure_dirs
  runtime_available || die "independent Tor runtime is missing under $TUNNEL_LIBEXEC_DIR; install the DevFix Tunnel package"

  old_pid=$(state_get PID '')
  old_state=$(state_get STATE '')
  old_mode=$(state_get MODE '')

  if [ "$old_state" = "CONNECTED" ] && pid_is_owned "$old_pid"; then
    if [ "$requested_mode" = "$old_mode" ]; then
      return 0
    fi
    if [ "$old_mode" = "SYSTEM_PROXY" ]; then
      die "an active System Proxy session already exists; disconnect or repair it before starting another transport mode"
    fi
    stop_owned_tor "$old_pid" || die "could not safely stop the previous tunnel-owned SOCKS transport"
  elif [ -n "$old_pid" ] && is_pid_alive "$old_pid"; then
    if ! pid_is_owned "$old_pid"; then
      die "stale state references a live process not owned by DevFix Tunnel; run 'devfix-tunnel repair' after reviewing status"
    fi
    if [ "$old_mode" = "SYSTEM_PROXY" ]; then
      die "stale System Proxy state with a live owned Tor process requires 'devfix-tunnel repair' before transport restart"
    fi
    stop_owned_tor "$old_pid" || die "could not safely stop stale tunnel-owned Tor process"
  fi

  clear_runtime_state
  port=$(choose_socks_port "$DEFAULT_SOCKS_PORT") ||
    die "no free local SOCKS port in $DEFAULT_SOCKS_PORT-$((DEFAULT_SOCKS_PORT + 19))"
  write_torrc "$port"
  : > "$TUNNEL_TOR_LOG"
  chmod 600 "$TUNNEL_TOR_LOG" 2>/dev/null || true

  session="$(now_epoch)-$$"
  started="$(now_utc)"
  write_state STARTING SOCKS '' "$port" "$session" "$started" ''
  info "Starting DevFix Tunnel Snowflake transport..."
  "$TUNNEL_TOR_BIN" -f "$TUNNEL_TORRC" >> "$TUNNEL_TOR_LOG" 2>&1 &
  pid=$!
  printf '%s\n' "$pid" > "$TUNNEL_PID_FILE"
  chmod 600 "$TUNNEL_PID_FILE" 2>/dev/null || true
  write_state BOOTSTRAPPING SOCKS "$pid" "$port" "$session" "$started" ''
  log_line "session=$session state=BOOTSTRAPPING pid=$pid port=$port"

  start_epoch=$(now_epoch)
  deadline=$((start_epoch + BOOTSTRAP_TIMEOUT))
  last_progress_epoch=$start_epoch
  last_percent=-1
  while [ "$(now_epoch)" -lt "$deadline" ]; do
    if ! is_pid_alive "$pid"; then
      write_state FAILED SOCKS "$pid" "$port" "$session" "$started" ''
      err "TRANSPORT_PROCESS_FAILURE: Tor exited before bootstrap completed."
      return 1
    fi
    percent=$(bootstrap_percent)
    if [ "$percent" != "$last_percent" ]; then
      info "Bootstrapped ${percent}%"
      last_percent="$percent"
      last_progress_epoch=$(now_epoch)
    fi
    if [ "$percent" -ge 100 ] 2>/dev/null; then
      break
    fi
    if [ $(( $(now_epoch) - last_progress_epoch )) -ge "$STALL_TIMEOUT" ]; then
      stop_owned_tor "$pid" || true
      write_state FAILED SOCKS "$pid" "$port" "$session" "$started" ''
      err "SNOWFLAKE_BOOTSTRAP_FAILURE: bootstrap stalled at ${percent}% for ${STALL_TIMEOUT}s."
      return 1
    fi
    sleep 1
  done

  percent=$(bootstrap_percent)
  if [ "$percent" -lt 100 ] 2>/dev/null; then
    stop_owned_tor "$pid" || true
    write_state FAILED SOCKS "$pid" "$port" "$session" "$started" ''
    err "TIMEOUT: Snowflake did not reach 100% within ${BOOTSTRAP_TIMEOUT}s."
    return 1
  fi

  write_state VALIDATING SOCKS "$pid" "$port" "$session" "$started" ''
  info "Snowflake bootstrap complete; validating SOCKS route..."
  if ! validate_socks_route "$port"; then
    stop_owned_tor "$pid" || true
    write_state FAILED SOCKS "$pid" "$port" "$session" "$started" ''
    err "ROUTE_VALIDATION_FAILURE: Tor reached 100% but routed HTTPS validation failed."
    return 1
  fi

  write_state CONNECTED SOCKS "$pid" "$port" "$session" "$started" ''
  log_line "session=$session state=CONNECTED mode=SOCKS pid=$pid port=$port"
  info "Snowflake transport is ready."
  info "Local SOCKS: socks5h://127.0.0.1:$port"
}

marker_get() { file="$1"; key="$2"; default_value="${3:-}"; [ -f "$file" ] || { printf '%s' "$default_value"; return; }; value=$(sed -n "s/^${key}=//p" "$file" | tail -n 1); [ -n "$value" ] && printf '%s' "$value" || printf '%s' "$default_value"; }

sudo_bin() {
  if [ -n "${DEVFIX_TUNNEL_SUDO_BIN:-}" ]; then printf '%s' "$DEVFIX_TUNNEL_SUDO_BIN";
  elif [ -x /usr/bin/sudo ]; then printf '%s' /usr/bin/sudo;
  elif command -v sudo >/dev/null 2>&1; then command -v sudo; else return 1; fi
}

start_system_proxy_guardian() {
  service_override="$1"
  [ "$(uname -s 2>/dev/null || true)" = "Darwin" ] || { [ "$TUNNEL_TEST_MODE" = "1" ] || die "System Proxy mode is supported only on macOS"; }
  [ -x "$TUNNEL_GUARDIAN_BIN" ] || die "guardian helper missing: $TUNNEL_GUARDIAN_BIN"
  pid=$(state_get PID ''); port=$(state_get SOCKS_PORT ''); session=$(state_get SESSION ''); started=$(state_get STARTED '')
  pid_is_owned "$pid" || die "cannot enable System Proxy because Tor ownership/health is not proven"
  rm -f "$TUNNEL_STOP_REQUEST" "$TUNNEL_PROXY_READY" "$TUNNEL_PROXY_FAILED" "$TUNNEL_PROXY_RESTORED"
  uid=$(id -u); gid=$(id -g)
  args=(apply --user-state "$TUNNEL_STATE_ROOT" --session "$session" --tor-pid "$pid" --port "$port" --uid "$uid" --gid "$gid")
  if [ -n "$service_override" ]; then args+=(--service "$service_override"); fi
  if [ "$TUNNEL_TEST_MODE" = "1" ]; then "$TUNNEL_GUARDIAN_BIN" "${args[@]}" >> "$TUNNEL_GUARDIAN_LOG" 2>&1 &
  else sb=$(sudo_bin) || die "sudo is required for safe macOS System Proxy changes"; "$sb" -v || die "administrator authorization is required for System Proxy mode"; "$sb" -n /usr/bin/nohup "$TUNNEL_GUARDIAN_BIN" "${args[@]}" >> "$TUNNEL_GUARDIAN_LOG" 2>&1 & fi
  deadline=$(( $(now_epoch) + GUARDIAN_START_TIMEOUT ))
  while [ "$(now_epoch)" -lt "$deadline" ]; do
    if [ -f "$TUNNEL_PROXY_READY" ]; then ready_session=$(marker_get "$TUNNEL_PROXY_READY" SESSION ''); [ "$ready_session" = "$session" ] || die "guardian readiness marker belongs to a different session"; service=$(marker_get "$TUNNEL_PROXY_READY" SERVICE ''); write_state CONNECTED SYSTEM_PROXY "$pid" "$port" "$session" "$started" "$service"; log_line "session=$session state=CONNECTED mode=SYSTEM_PROXY service=$service"; info "System Proxy enabled safely for network service: $service"; info "Safari/Chrome and other apps that honor macOS System Proxy can now use the Snowflake route."; return 0; fi
    if [ -f "$TUNNEL_PROXY_FAILED" ]; then reason=$(marker_get "$TUNNEL_PROXY_FAILED" REASON 'GUARDIAN_FAILURE'); err "SYSTEM_PROXY_FAILURE: $reason"; return 1; fi
    sleep 0.25
  done
  err "SYSTEM_PROXY_FAILURE: guardian did not become ready within ${GUARDIAN_START_TIMEOUT}s"; return 1
}

request_proxy_restore() {
  session=$(state_get SESSION ''); [ -n "$session" ] || return 0; ensure_dirs
  printf 'SESSION=%s\n' "$session" > "$TUNNEL_STOP_REQUEST"; chmod 600 "$TUNNEL_STOP_REQUEST" 2>/dev/null || true
  deadline=$(( $(now_epoch) + GUARDIAN_STOP_TIMEOUT ))
  while [ "$(now_epoch)" -lt "$deadline" ]; do
    if [ -f "$TUNNEL_PROXY_RESTORED" ]; then restored_session=$(marker_get "$TUNNEL_PROXY_RESTORED" SESSION ''); [ "$restored_session" = "$session" ] && return 0; fi
    if [ -f "$TUNNEL_PROXY_FAILED" ]; then reason=$(marker_get "$TUNNEL_PROXY_FAILED" REASON 'RESTORE_FAILURE'); warn "guardian restore reported: $reason"; break; fi
    sleep 0.25
  done
  [ -x "$TUNNEL_GUARDIAN_BIN" ] || return 1
  args=(recover --user-state "$TUNNEL_STATE_ROOT" --session "$session" --uid "$(id -u)" --gid "$(id -g)")
  if [ "$TUNNEL_TEST_MODE" = "1" ]; then "$TUNNEL_GUARDIAN_BIN" "${args[@]}"; else sb=$(sudo_bin) || return 1; "$sb" "$TUNNEL_GUARDIAN_BIN" "${args[@]}"; fi
}

cmd_connect() {
  mode="system"
  service=""
  if [ "${1:-}" = "socks" ]; then
    mode="socks"
    shift
  elif [ "${1:-}" = "system" ]; then
    mode="system"
    shift
  fi

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --service)
        [ "$#" -ge 2 ] || die "--service requires a network service name"
        service="$2"
        shift 2
        ;;
      *) die "unknown connect option: $1" ;;
    esac
  done

  existing_state=$(state_get STATE DISCONNECTED)
  existing_mode=$(state_get MODE NONE)
  existing_pid=$(state_get PID '')
  if [ "$existing_state" = "CONNECTED" ] && pid_is_owned "$existing_pid"; then
    case "$mode:$existing_mode" in
      system:SYSTEM_PROXY)
        if [ -f "$TUNNEL_PROXY_FAILED" ]; then
          die "existing System Proxy session is degraded; run 'devfix-tunnel status' and 'devfix-tunnel repair'"
        fi
        info "DevFix Tunnel is already connected in System Proxy mode."
        return 0
        ;;
      socks:SOCKS)
        info "DevFix Tunnel is already connected in SOCKS-only mode."
        return 0
        ;;
      socks:SYSTEM_PROXY)
        die "already connected in System Proxy mode; disconnect before switching to SOCKS-only mode"
        ;;
      system:SOCKS)
        die "already connected in SOCKS-only mode; disconnect before switching to System Proxy mode"
        ;;
    esac
  fi

  if [ "$mode" = "socks" ]; then
    start_transport SOCKS || exit 1
    info "Connected in SOCKS-only mode. macOS System Proxy was not changed."
    return 0
  fi

  start_transport SYSTEM_PROXY || exit 1
  if ! start_system_proxy_guardian "$service"; then
    pid=$(state_get PID '')
    stop_owned_tor "$pid" || true
    clear_runtime_state
    die "System Proxy activation failed; transport was rolled back"
  fi
  info "Connected with DevFix Tunnel System Proxy."
}

cmd_status() {
  state=$(state_get STATE DISCONNECTED); mode=$(state_get MODE NONE); pid=$(state_get PID ''); port=$(state_get SOCKS_PORT ''); session=$(state_get SESSION ''); service=$(state_get PROXY_SERVICE '')
  printf '%s %s\n' "$TUNNEL_NAME" "$TUNNEL_VERSION"; printf 'State: %s\n' "$state"; printf 'Mode: %s\n' "$mode"
  [ -n "$session" ] && printf 'Session: %s\n' "$session"; [ -n "$port" ] && printf 'SOCKS: socks5h://127.0.0.1:%s\n' "$port"; [ -n "$service" ] && printf 'System Proxy service: %s\n' "$service"
  if [ -n "$pid" ]; then if pid_is_owned "$pid"; then printf 'Tor PID: %s (owned/alive)\n' "$pid"; elif is_pid_alive "$pid"; then printf 'Tor PID: %s (alive, ownership NOT proven)\n' "$pid"; else printf 'Tor PID: %s (not alive)\n' "$pid"; fi; fi
  if [ -f "$TUNNEL_PROXY_FAILED" ]; then printf 'Guardian: DEGRADED (%s)\n' "$(marker_get "$TUNNEL_PROXY_FAILED" REASON unknown)"; return 1; fi
  if [ "$state" = "CONNECTED" ] && ! pid_is_owned "$pid"; then printf 'Health: DEGRADED\n'; return 1; fi
  if [ "$mode" = "SYSTEM_PROXY" ] && [ ! -f "$TUNNEL_PROXY_READY" ]; then printf 'System Proxy health: NOT VERIFIED\n'; return 1; fi
  [ "$state" = "CONNECTED" ] && printf 'Health: OK\n'; return 0
}

cmd_disconnect() {
  mode=$(state_get MODE NONE); pid=$(state_get PID ''); session=$(state_get SESSION '')
  if [ "$mode" = "SYSTEM_PROXY" ] || [ -f "$TUNNEL_PROXY_READY" ]; then info "Restoring previous macOS proxy settings..."; if ! request_proxy_restore; then err "RESTORE_FAILURE: automatic System Proxy restoration could not be verified."; err "Run: devfix-tunnel repair"; exit 1; fi; fi
  if [ -n "$pid" ] && is_pid_alive "$pid"; then stop_owned_tor "$pid" || die "could not safely stop tunnel-owned Tor process"; fi
  clear_runtime_state; log_line "session=$session state=DISCONNECTED"; info "DevFix Tunnel disconnected."; info "Previous System Proxy state restored or no tunnel-owned proxy was active."
}


cmd_restart() {
  requested="${1:-}"
  if [ -z "$requested" ]; then
    current_mode=$(state_get MODE NONE)
    case "$current_mode" in
      SOCKS) requested="socks" ;;
      SYSTEM_PROXY) requested="system" ;;
      *) requested="system" ;;
    esac
  fi
  case "$requested" in
    system|socks) ;;
    *) die "restart mode must be 'system' or 'socks'" ;;
  esac
  cmd_disconnect || return 1
  cmd_connect "$requested"
}
cmd_repair() {
  ensure_dirs; session=$(state_get SESSION '')
  if [ -x "$TUNNEL_GUARDIAN_BIN" ]; then args=(recover --user-state "$TUNNEL_STATE_ROOT" --uid "$(id -u)" --gid "$(id -g)"); [ -n "$session" ] && args+=(--session "$session"); if [ "$TUNNEL_TEST_MODE" = "1" ]; then "$TUNNEL_GUARDIAN_BIN" "${args[@]}" || true; elif [ "$(uname -s 2>/dev/null || true)" = "Darwin" ]; then sb=$(sudo_bin) || die "sudo is required for repair"; "$sb" "$TUNNEL_GUARDIAN_BIN" "${args[@]}" || die "guardian could not safely repair System Proxy state"; fi; fi
  pid=$(state_get PID ''); if [ -n "$pid" ] && is_pid_alive "$pid"; then stop_owned_tor "$pid" || die "refusing to stop unowned process during repair"; fi
  clear_runtime_state; info "DevFix Tunnel repair completed."
}

cmd_doctor() {
  fail=0; printf '%s %s doctor\n' "$TUNNEL_NAME" "$TUNNEL_VERSION"; printf 'OS: %s\n' "$(uname -s 2>/dev/null || printf unknown)"; printf 'Architecture: %s\n' "$(uname -m 2>/dev/null || printf unknown)"
  if [ -x "$TUNNEL_TOR_BIN" ]; then printf 'Tor runtime: OK (%s)\n' "$TUNNEL_TOR_BIN"; else printf 'Tor runtime: MISSING (%s)\n' "$TUNNEL_TOR_BIN"; fail=1; fi
  if [ -x "$TUNNEL_LYREBIRD_BIN" ]; then printf 'lyrebird runtime: OK\n'; else printf 'lyrebird runtime: MISSING\n'; fail=1; fi
  if [ -x "$TUNNEL_GUARDIAN_BIN" ]; then printf 'System Proxy guardian: OK\n'; else printf 'System Proxy guardian: MISSING (%s)\n' "$TUNNEL_GUARDIAN_BIN"; fail=1; fi
  if [ "$(uname -s 2>/dev/null || true)" = "Darwin" ]; then if [ -x /usr/sbin/networksetup ]; then printf 'networksetup: OK\n'; else printf 'networksetup: MISSING\n'; fail=1; fi; if [ -x /sbin/route ]; then printf 'route: OK\n'; else printf 'route: MISSING\n'; fail=1; fi; if sudo_bin >/dev/null 2>&1; then printf 'sudo: OK\n'; else printf 'sudo: MISSING\n'; fail=1; fi; else printf 'System Proxy support: N/A outside macOS\n'; fi
  printf 'Current state: %s\n' "$(state_get STATE DISCONNECTED)"; [ "$fail" -eq 0 ]
}

cmd_open() { url="${1:-}"; [ -n "$url" ] || die "usage: devfix-tunnel open https://example.com"; case "$url" in http://*|https://*) ;; *) die "open accepts only http:// or https:// URLs" ;; esac; [ "$(state_get STATE DISCONNECTED)" = "CONNECTED" ] || die "tunnel is not connected"; [ "$(state_get MODE NONE)" = "SYSTEM_PROXY" ] || die "open requires System Proxy mode"; if [ "$TUNNEL_TEST_MODE" = "1" ]; then info "TEST open: $url"; return 0; fi; [ -x /usr/bin/open ] || die "macOS open command not found"; /usr/bin/open "$url"; }

cmd_logs() { ensure_dirs; lines="${1:-100}"; case "$lines" in ''|*[!0-9]*) die "logs expects a numeric line count" ;; esac; printf '%s\n' '===== controller ====='; tail -n "$lines" "$TUNNEL_LOG" 2>/dev/null || true; printf '%s\n' '===== tor ====='; tail -n "$lines" "$TUNNEL_TOR_LOG" 2>/dev/null || true; printf '%s\n' '===== guardian launcher ====='; tail -n "$lines" "$TUNNEL_GUARDIAN_LOG" 2>/dev/null || true; }

usage() { cat <<EOF
$TUNNEL_NAME $TUNNEL_VERSION

Usage:
  devfix-tunnel connect [system|socks] [--service "Network Service"]
  devfix-tunnel status
  devfix-tunnel disconnect
  devfix-tunnel restart [system|socks]
  devfix-tunnel repair
  devfix-tunnel doctor
  devfix-tunnel open https://example.com
  devfix-tunnel logs [lines]
  devfix-tunnel version
  devfix-tunnel help

Modes:
  system  Start Snowflake and safely enable macOS System SOCKS Proxy.
          This is the default and targets Safari/Chrome plus other apps
          that honor macOS System Proxy settings.
  socks   Start only an isolated local SOCKS endpoint. No macOS network settings are changed.

Safety:
  - DevFix and DevFix Tunnel use separate runtime/state paths.
  - Existing third-party proxy/PAC settings cause a fail-closed stop.
  - Proxy changes are owned by a root guardian with snapshot/restore.
  - A boot recovery LaunchDaemon restores stale tunnel-owned proxy state.
  - External proxy changes are never blindly overwritten.
  - This System Proxy edition is not a full packet-level VPN.
EOF
}

case "${1:-help}" in
  connect) shift; cmd_connect "$@" ;;
  status) shift; cmd_status "$@" ;;
  disconnect) shift; cmd_disconnect "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  repair) shift; cmd_repair "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  open) shift; cmd_open "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  version|--version|-V) printf '%s %s\n' "$TUNNEL_NAME" "$TUNNEL_VERSION" ;;
  help|-h|--help) usage ;;
  *) err "unknown command: ${1:-}"; usage >&2; exit 2 ;;
esac
