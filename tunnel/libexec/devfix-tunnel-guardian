#!/bin/bash
# DevFix Tunnel privileged System Proxy guardian.
# Owns only proxy state created by DevFix Tunnel and restores it conservatively.

set -u

GUARDIAN_VERSION="0.2.0-rc1"
TEST_MODE="${DEVFIX_TUNNEL_TEST_MODE:-0}"
SYSTEM_STATE_DIR="${DEVFIX_TUNNEL_SYSTEM_STATE_DIR:-/Library/Application Support/DevFixTunnel}"
NETWORKSETUP_BIN="${DEVFIX_TUNNEL_NETWORKSETUP_BIN:-/usr/sbin/networksetup}"
ROUTE_BIN="${DEVFIX_TUNNEL_ROUTE_BIN:-/sbin/route}"
SLEEP_BIN="${DEVFIX_TUNNEL_SLEEP_BIN:-/bin/sleep}"
CURRENT_FILE="$SYSTEM_STATE_DIR/current"
GUARDIAN_LOG="$SYSTEM_STATE_DIR/guardian.log"

now_utc() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
require_root() { if [ "$TEST_MODE" != "1" ] && [ "$(id -u)" -ne 0 ]; then die "guardian must run as root"; fi; }

path_owner_uid() { path="$1"; if stat -f '%u' "$path" >/dev/null 2>&1; then stat -f '%u' "$path"; else stat -c '%u' "$path" 2>/dev/null; fi; }
validate_user_state() { user_state="$1"; uid="$2"; gid="$3"; case "$uid" in ''|*[!0-9]*) return 1 ;; esac; case "$gid" in ''|*[!0-9]*) return 1 ;; esac; case "$user_state" in /*) ;; *) return 1 ;; esac; case "$user_state" in *$'\n'*|*$'\r'*) return 1 ;; esac; [ -d "$user_state" ] || return 1; [ ! -L "$user_state" ] || return 1; [ -d "$user_state/run" ] || return 1; [ ! -L "$user_state/run" ] || return 1; owner=$(path_owner_uid "$user_state") || return 1; run_owner=$(path_owner_uid "$user_state/run") || return 1; [ "$owner" = "$uid" ] && [ "$run_owner" = "$uid" ]; }
ensure_system_dir() { umask 077; mkdir -p "$SYSTEM_STATE_DIR" || die "cannot create system guardian state"; chmod 700 "$SYSTEM_STATE_DIR" 2>/dev/null || true; }
log_line() { ensure_system_dir; printf '%s %s\n' "$(now_utc)" "$*" >> "$GUARDIAN_LOG" 2>/dev/null || true; }

safe_user_marker() { user_state="$1"; name="$2"; content="$3"; uid="${4:-}"; gid="${5:-}"; run_dir="$user_state/run"; mkdir -p "$run_dir" 2>/dev/null || return 1; tmp="$run_dir/$name.tmp.$$"; printf '%s\n' "$content" > "$tmp" || return 1; chmod 600 "$tmp" 2>/dev/null || true; if [ -n "$uid" ] && [ -n "$gid" ] && [ "$TEST_MODE" != "1" ]; then chown "$uid:$gid" "$tmp" 2>/dev/null || true; fi; mv "$tmp" "$run_dir/$name"; }
owner_get() { key="$1"; default_value="${2:-}"; [ -f "$CURRENT_FILE" ] || { printf '%s' "$default_value"; return; }; value=$(sed -n "s/^${key}=//p" "$CURRENT_FILE" | tail -n 1); [ -n "$value" ] && printf '%s' "$value" || printf '%s' "$default_value"; }
write_owner() { session="$1"; phase="$2"; service="$3"; port="$4"; user_state="$5"; uid="$6"; gid="$7"; snapshot="$8"; guardian_pid="${9:-}"; ensure_system_dir; tmp="$CURRENT_FILE.tmp.$$"; umask 077; { printf 'SCHEMA=1\n'; printf 'SESSION=%s\n' "$session"; printf 'PHASE=%s\n' "$phase"; printf 'SERVICE=%s\n' "$service"; printf 'PORT=%s\n' "$port"; printf 'USER_STATE=%s\n' "$user_state"; printf 'UID=%s\n' "$uid"; printf 'GID=%s\n' "$gid"; printf 'SNAPSHOT=%s\n' "$snapshot"; printf 'GUARDIAN_PID=%s\n' "$guardian_pid"; printf 'UPDATED=%s\n' "$(now_utc)"; } > "$tmp" || die "cannot write guardian ownership state"; chmod 600 "$tmp" 2>/dev/null || true; mv "$tmp" "$CURRENT_FILE"; }
ns_read() { "$NETWORKSETUP_BIN" "$@" 2>/dev/null; }
ns_set() { "$NETWORKSETUP_BIN" "$@"; }
route_interface() { "$ROUTE_BIN" -n get default 2>/dev/null | awk '/interface:/{print $2; exit}'; }
service_for_interface() { wanted="$1"; ns_read -listnetworkserviceorder | awk -v wanted="$wanted" '/^\([0-9]+\)/ {name=$0; sub(/^\([0-9]+\)[[:space:]]*/, "", name); sub(/^\*/, "", name); next} /Device:/ {line=$0; sub(/^.*Device:[[:space:]]*/, "", line); sub(/\).*$/, "", line); if (line == wanted && name != "") {print name; exit}}'; }
discover_service() { explicit="${1:-}"; if [ -n "$explicit" ]; then ns_read -getinfo "$explicit" >/dev/null 2>&1 || return 1; printf '%s' "$explicit"; return 0; fi; iface=$(route_interface); [ -n "$iface" ] || return 1; service_for_interface "$iface"; }
proxy_field() { data="$1"; field="$2"; printf '%s\n' "$data" | awk -F': ' -v field="$field" '$1 == field {sub($1 FS, ""); print; exit}'; }
proxy_enabled() { printf '%s\n' "$1" | grep -Eq '^(Enabled:[[:space:]]*Yes|Auto Proxy Discovery:[[:space:]]*On)$'; }

capture_snapshot() { service="$1"; snapshot="$2"; umask 077; mkdir -p "$snapshot" || return 1; chmod 700 "$snapshot" 2>/dev/null || true; printf '%s\n' "$service" > "$snapshot/service"; ns_read -getsocksfirewallproxy "$service" > "$snapshot/socks" || return 1; ns_read -getwebproxy "$service" > "$snapshot/web" || return 1; ns_read -getsecurewebproxy "$service" > "$snapshot/secureweb" || return 1; ns_read -getautoproxyurl "$service" > "$snapshot/autoproxy" || return 1; if ns_read -getproxyautodiscovery "$service" > "$snapshot/autodiscovery" 2>/dev/null; then :; else printf '%s\n' 'Auto Proxy Discovery: Off' > "$snapshot/autodiscovery"; fi; ns_read -getproxybypassdomains "$service" > "$snapshot/bypass" 2>/dev/null || true; }
snapshot_conflict_reason() { snapshot="$1"; socks=$(cat "$snapshot/socks"); web=$(cat "$snapshot/web"); secure=$(cat "$snapshot/secureweb"); auto=$(cat "$snapshot/autoproxy"); discovery=$(cat "$snapshot/autodiscovery"); if proxy_enabled "$socks"; then printf '%s' 'EXISTING_SOCKS_PROXY'; return; fi; if proxy_enabled "$web"; then printf '%s' 'EXISTING_HTTP_PROXY'; return; fi; if proxy_enabled "$secure"; then printf '%s' 'EXISTING_HTTPS_PROXY'; return; fi; if proxy_enabled "$auto"; then printf '%s' 'EXISTING_PAC_PROXY'; return; fi; if proxy_enabled "$discovery"; then printf '%s' 'EXISTING_PROXY_AUTODISCOVERY'; return; fi; printf '%s' ''; }
current_socks() { ns_read -getsocksfirewallproxy "$1"; }
proxy_matches_owned() { service="$1"; port="$2"; data=$(current_socks "$service") || return 1; enabled=$(proxy_field "$data" Enabled); server=$(proxy_field "$data" Server); current_port=$(proxy_field "$data" Port); [ "$enabled" = "Yes" ] && { [ "$server" = "127.0.0.1" ] || [ "$server" = "localhost" ]; } && [ "$current_port" = "$port" ]; }
apply_owned_proxy() { service="$1"; port="$2"; ns_set -setsocksfirewallproxy "$service" 127.0.0.1 "$port" off >/dev/null; ns_set -setsocksfirewallproxystate "$service" on >/dev/null; proxy_matches_owned "$service" "$port"; }
restore_snapshot() { service="$1"; snapshot="$2"; previous=$(cat "$snapshot/socks"); previous_enabled=$(proxy_field "$previous" Enabled); previous_server=$(proxy_field "$previous" Server); previous_port=$(proxy_field "$previous" Port); if [ -n "$previous_server" ] && case "$previous_port" in ''|*[!0-9]*) false ;; *) true ;; esac; then ns_set -setsocksfirewallproxy "$service" "$previous_server" "$previous_port" off >/dev/null || return 1; fi; case "$previous_enabled" in Yes) ns_set -setsocksfirewallproxystate "$service" on >/dev/null || return 1 ;; *) ns_set -setsocksfirewallproxystate "$service" off >/dev/null || return 1 ;; esac; after=$(current_socks "$service") || return 1; after_enabled=$(proxy_field "$after" Enabled); if [ "$previous_enabled" = "Yes" ]; then [ "$after_enabled" = "Yes" ]; else [ "$after_enabled" != "Yes" ]; fi; }
clear_owner_after_restore() { snapshot="$1"; if [ -d "$snapshot" ]; then rm -rf "$SYSTEM_STATE_DIR/last-restored"; mv "$snapshot" "$SYSTEM_STATE_DIR/last-restored" 2>/dev/null || rm -rf "$snapshot"; fi; rm -f "$CURRENT_FILE"; }

recover_owned_proxy() { requested_session="${1:-}"; marker_user_state="${2:-}"; marker_uid="${3:-}"; marker_gid="${4:-}"; [ -f "$CURRENT_FILE" ] || { [ -n "$marker_user_state" ] && safe_user_marker "$marker_user_state" "system-proxy.restored" "SESSION=${requested_session:-none}
RESULT=NO_OWNED_PROXY" "$marker_uid" "$marker_gid" || true; return 0; }; session=$(owner_get SESSION ''); phase=$(owner_get PHASE ''); service=$(owner_get SERVICE ''); port=$(owner_get PORT ''); user_state=$(owner_get USER_STATE "$marker_user_state"); uid=$(owner_get UID "$marker_uid"); gid=$(owner_get GID "$marker_gid"); snapshot=$(owner_get SNAPSHOT ''); if [ -n "$requested_session" ] && [ "$session" != "$requested_session" ]; then log_line "recover_refused requested=$requested_session owned=$session reason=SESSION_MISMATCH"; return 2; fi; case "$phase" in SNAPSHOTTED) rm -f "$CURRENT_FILE"; [ -d "$snapshot" ] && rm -rf "$snapshot"; safe_user_marker "$user_state" "system-proxy.restored" "SESSION=$session
RESULT=SNAPSHOT_ONLY_CLEARED" "$uid" "$gid" || true; return 0 ;; APPLIED) if proxy_matches_owned "$service" "$port"; then if restore_snapshot "$service" "$snapshot"; then clear_owner_after_restore "$snapshot"; safe_user_marker "$user_state" "system-proxy.restored" "SESSION=$session
SERVICE=$service
RESULT=RESTORED" "$uid" "$gid" || true; rm -f "$user_state/run/system-proxy.ready" 2>/dev/null || true; log_line "session=$session restore=success service=$service"; return 0; fi; safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=RESTORE_COMMAND_FAILED" "$uid" "$gid" || true; return 1; fi; write_owner "$session" CONFLICT "$service" "$port" "$user_state" "$uid" "$gid" "$snapshot" "$(owner_get GUARDIAN_PID '')"; safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=PROXY_OWNERSHIP_LOST" "$uid" "$gid" || true; return 3 ;; CONFLICT) safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=PROXY_OWNERSHIP_CONFLICT_REQUIRES_MANUAL_REVIEW" "$uid" "$gid" || true; return 3 ;; *) return 4 ;; esac; }

guardian_monitor() { session="$1"; tor_pid="$2"; service="$3"; port="$4"; user_state="$5"; uid="$6"; gid="$7"; stop_file="$user_state/run/system-proxy.stop"; original_service="$service"; while :; do if [ -f "$stop_file" ]; then requested=$(sed -n 's/^SESSION=//p' "$stop_file" | tail -n 1); if [ -z "$requested" ] || [ "$requested" = "$session" ]; then recover_owned_proxy "$session" "$user_state" "$uid" "$gid"; return $?; fi; fi; if ! kill -0 "$tor_pid" 2>/dev/null; then safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=TOR_PROCESS_DIED" "$uid" "$gid" || true; recover_owned_proxy "$session" "$user_state" "$uid" "$gid"; return $?; fi; if ! proxy_matches_owned "$service" "$port"; then write_owner "$session" CONFLICT "$service" "$port" "$user_state" "$uid" "$gid" "$(owner_get SNAPSHOT '')" "$$"; safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=PROXY_OWNERSHIP_LOST" "$uid" "$gid" || true; return 3; fi; active=$(discover_service '' 2>/dev/null || true); if [ -n "$active" ] && [ "$active" != "$original_service" ]; then safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=NETWORK_SERVICE_CHANGED" "$uid" "$gid" || true; recover_owned_proxy "$session" "$user_state" "$uid" "$gid"; return $?; fi; "$SLEEP_BIN" 1; done; }

cmd_apply() { require_root; user_state=""; session=""; tor_pid=""; port=""; uid=""; gid=""; service_override=""; while [ "$#" -gt 0 ]; do case "$1" in --user-state) user_state="$2"; shift 2 ;; --session) session="$2"; shift 2 ;; --tor-pid) tor_pid="$2"; shift 2 ;; --port) port="$2"; shift 2 ;; --uid) uid="$2"; shift 2 ;; --gid) gid="$2"; shift 2 ;; --service) service_override="$2"; shift 2 ;; *) die "unknown apply argument: $1" ;; esac; done; [ -n "$user_state" ] && [ -n "$session" ] && [ -n "$tor_pid" ] && [ -n "$port" ] || die "apply requires user-state/session/tor-pid/port"; validate_user_state "$user_state" "$uid" "$gid" || die "user state path/ownership validation failed"; case "$session" in *$'\n'*|*$'\r'*) die "invalid session" ;; esac; case "$service_override" in *$'\n'*|*$'\r'*) die "invalid service name" ;; esac; case "$tor_pid" in *[!0-9]*|'') die "invalid tor pid" ;; esac; case "$port" in *[!0-9]*|'') die "invalid SOCKS port" ;; esac; ensure_system_dir; if [ -f "$CURRENT_FILE" ]; then if ! recover_owned_proxy '' "$user_state" "$uid" "$gid"; then safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=STALE_PROXY_RECOVERY_BLOCKED" "$uid" "$gid" || true; exit 1; fi; fi; service=$(discover_service "$service_override") || { safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=ACTIVE_NETWORK_SERVICE_NOT_FOUND" "$uid" "$gid" || true; exit 1; }; snapshot="$SYSTEM_STATE_DIR/snapshot-$session"; rm -rf "$snapshot"; capture_snapshot "$service" "$snapshot" || { safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=PROXY_SNAPSHOT_FAILED" "$uid" "$gid" || true; rm -rf "$snapshot"; exit 1; }; conflict=$(snapshot_conflict_reason "$snapshot"); if [ -n "$conflict" ]; then safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=$conflict" "$uid" "$gid" || true; rm -rf "$snapshot"; exit 1; fi; write_owner "$session" SNAPSHOTTED "$service" "$port" "$user_state" "$uid" "$gid" "$snapshot" "$$"; if ! apply_owned_proxy "$service" "$port"; then if proxy_matches_owned "$service" "$port"; then restore_snapshot "$service" "$snapshot" || true; fi; rm -f "$CURRENT_FILE"; rm -rf "$snapshot"; safe_user_marker "$user_state" "system-proxy.failed" "SESSION=$session
REASON=PROXY_APPLY_OR_VERIFY_FAILED" "$uid" "$gid" || true; exit 1; fi; write_owner "$session" APPLIED "$service" "$port" "$user_state" "$uid" "$gid" "$snapshot" "$$"; safe_user_marker "$user_state" "system-proxy.ready" "SESSION=$session
SERVICE=$service
PORT=$port
RESULT=ACTIVE" "$uid" "$gid" || { recover_owned_proxy "$session" "$user_state" "$uid" "$gid" || true; exit 1; }; guardian_monitor "$session" "$tor_pid" "$service" "$port" "$user_state" "$uid" "$gid"; }

cmd_recover() { require_root; user_state=""; session=""; uid=""; gid=""; while [ "$#" -gt 0 ]; do case "$1" in --user-state) user_state="$2"; shift 2 ;; --session) session="$2"; shift 2 ;; --uid) uid="$2"; shift 2 ;; --gid) gid="$2"; shift 2 ;; *) die "unknown recover argument: $1" ;; esac; done; if [ -n "$user_state" ]; then validate_user_state "$user_state" "$uid" "$gid" || die "user state path/ownership validation failed"; fi; recover_owned_proxy "$session" "$user_state" "$uid" "$gid"; }

guardian_process_owned() { pid="$1"; session="$2"; case "$pid" in ''|*[!0-9]*) return 1 ;; esac; kill -0 "$pid" 2>/dev/null || return 1; [ "$TEST_MODE" = "1" ] && return 0; cmd=$(ps -p "$pid" -o command= 2>/dev/null || true); case "$cmd" in *devfix-tunnel-guardian*"apply"*"$session"*) return 0 ;; *) return 1 ;; esac; }
cmd_recover_orphaned() { require_root; ensure_system_dir; [ -f "$CURRENT_FILE" ] || exit 0; session=$(owner_get SESSION ''); guardian_pid=$(owner_get GUARDIAN_PID ''); if guardian_process_owned "$guardian_pid" "$session"; then exit 0; fi; attempts=0; while [ "$attempts" -lt 30 ]; do [ -f "$CURRENT_FILE" ] || exit 0; phase=$(owner_get PHASE ''); if [ "$phase" = "SNAPSHOTTED" ]; then recover_owned_proxy '' '' '' ''; exit $?; fi; service=$(owner_get SERVICE ''); if [ -n "$service" ] && ns_read -getinfo "$service" >/dev/null 2>&1; then recover_owned_proxy '' '' '' ''; exit $?; fi; attempts=$((attempts + 1)); "$SLEEP_BIN" 2; done; log_line "boot_recovery=deferred reason=NETWORK_SERVICE_UNAVAILABLE"; exit 1; }

case "${1:-}" in apply) shift; cmd_apply "$@" ;; recover) shift; cmd_recover "$@" ;; recover-orphaned) shift; cmd_recover_orphaned "$@" ;; version|--version) printf 'DevFix Tunnel guardian %s\n' "$GUARDIAN_VERSION" ;; *) die "guardian internal command required" ;; esac
